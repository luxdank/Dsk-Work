rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reusable helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdminUser() {
      return isSignedIn() && (
        (request.auth.token.email == 'lhgsdos@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isManagerOrAdmin() {
      return isSignedIn() && (
        isAdminUser() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'gestor')
      );
    }

    // Test connection document for app initialization check
    match /test/{docId} {
      allow read, write: if isSignedIn();
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdminUser());
      allow delete: if isAdminUser();
    }

    // Departments collection
    match /departments/{departmentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isManagerOrAdmin();
    }

    // Projects collection
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isManagerOrAdmin() || (isSignedIn() && resource.data.memberIds.hasAny([request.auth.uid]));
      allow delete: if isAdminUser() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    // Project Members
    match /projectMembers/{memberId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Boards
    match /boards/{boardId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Columns
    match /columns/{columnId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Tasks
    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Comments
    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdminUser());
    }

    // Checklists
    match /checklists/{checklistId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdminUser());
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdminUser());
    }

    // Activity Logs
    match /activityLogs/{activityId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdminUser();
    }
  }
}
